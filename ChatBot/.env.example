# Copie para um arquivo local não versionado e preencha sem compartilhar os valores.
OPENAI_API_KEY=COLE_A_CHAVE_AQUI
OPENAI_MODEL=gpt-4.1-mini

# Use um clientId diferente em homologação para não disputar a sessão da produção.
WWEBJS_CLIENT_ID=bot2vales-homolog

# Nunca use o grupo real da produção durante os testes.
GRUPO_RESERVAS_ID=COLE_O_ID_DO_GRUPO_DE_HOMOLOGACAO@g.us

# Use caminho absoluto no VPS.
CARDAPIO_PATH=/root/bot-whatsapp-2vales/ChatBot/Arquivos/Cardapio leve.pdf
